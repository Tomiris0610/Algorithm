class Node:
    def __init__(self, data):
        self.data = data
        self.next = None


class LinkedList:
    def __init__(self):
        self.head = None

    # добавление в начало
    def add_to_start(self, data):
        new_node = Node(data)   # создаём новый узел
        new_node.next = self.head  # он указывает на старый head
        self.head = new_node       # теперь он становится head

    # вывод списка
    def print_list(self):
        current = self.head
        while current:
            print(current.data, end=" -> ")
            current = current.next
        print("None")


# использование
my_list = LinkedList()

my_list.add_to_start(10)
my_list.add_to_start(20)
my_list.add_to_start(30)

my_list.print_list()
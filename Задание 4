# Считываем данные пользователя
age = int(input("Введите ваш возраст: "))
student = input("Есть ли у вас студенческий билет? (да/нет): ")

# Преобразуем ответ в логическое значение
has_student_card = student.lower() == "да"

# Проверяем право на льготный тариф
if age < 18 or has_student_card:
    print("Вы имеете право на льготный тариф")
else:
    print("Вы не имеете права на льготный тариф")
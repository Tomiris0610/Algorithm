# Считываем два целых числа
num1 = int(input("Введите первое число: "))
num2 = int(input("Введите второе число: "))

# Сравниваем числа
if num1 == num2:
    print("Числа равны.")
else:
    if num1 > num2:
        print(f"Большее число: {num1}")
    else:
        print(f"Большее число: {num2}")
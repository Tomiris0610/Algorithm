# Считываем целое число
score = int(input("Введите число от 1 до 100: "))

# Проверяем корректность диапазона
if score < 1 or score > 100:
    print("Ошибка: число должно быть от 1 до 100.")
# Определяем оценку
elif score >= 90:
    print("Оценка: A")
elif score >= 75:
    print("Оценка: B")
elif score >= 60:
    print("Оценка: C")
else:
    print("Оценка: D")
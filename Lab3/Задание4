# Считываем возраст пользователя
age = int(input("Введите ваш возраст: "))

# Считываем наличие студенческого билета
student_id = input("У вас есть студенческий билет? (да/нет): ").strip().lower()

# Проверяем, имеет ли пользователь право на льготный тариф
if age < 18 or student_id == "да":
    print("Вы имеете право на льготный тариф.")
else:
    print("Вы не имеете право на льготный тариф.")
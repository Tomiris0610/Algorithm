# Задание 1
import random
rows = int(input("Количество строк:"))
cols = int(input("Количество столбцов:"))

matrix = []

# Формирование матрицы
for i in range(rows):
    row = []
    for j in range(cols):
        row.append(random.randint(1, 20))
    matrix.append(row)

# Вывод матрицы
print("\nMatrica:")
for row in matrix:
    for value in row:
        print(f"{value:4}", end="")
    print()

# Поиск суммы и максимума
total = 0
maximum = matrix[0][0]

for row in matrix:
    for value in row:
        total += value
        if value > maximum:
            maximum = value

print("\nSumma elementov:", total)
print("Maksimalni element:", maximum)

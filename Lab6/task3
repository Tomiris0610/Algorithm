import random

SIZE = 4

# Создание поля 4×4
matrix = []

for i in range(SIZE):
    row = []
    for j in range(SIZE):
        # случайно либо 0, либо число от 1 до 9
        row.append(random.choice([0, random.randint(1, 9)]))
    matrix.append(row)

# Функция красивого вывода
def print_matrix(mat):
    for row in mat:
        for value in row:
            print(f"{value:4}", end="")
        print()

# Логика сдвига строки вправо
def shift_right(row):
    new_row = [x for x in row if x != 0]      # убираем нули
    zeros = [0] * (len(row) - len(new_row))  # добавляем нули слева
    return zeros + new_row

print("Do sdviga:")
print_matrix(matrix)

# Сдвиг всех строк вправо
for i in range(SIZE):
    matrix[i] = shift_right(matrix[i])
print("\nPosle sdviga v pravo:")
print_matrix(matrix)

# Считываем два целых числа
a = int(input("Введите первое число: "))
b = int(input("Введите второе число: "))

# Сравниваем числа с использованием вложенных условий
if a == b:
    print("Числа равны")
else:
    if a > b:
        print("Большее число:", a)
    else:
        print("Большее число:", b)